enum user_status {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum user_role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum active_status {
  ACTIVE
  INACTIVE
}

enum reactivation_request_status {
  PENDING
  APPROVED
  REJECTED
}

model users {
  id                             Uuid                            @id @default(uuid())
  name                           VarChar(100)
  email                          VarChar(255)                    @unique
  password_hash                  VarChar(255)
  phone                          VarChar(20)?

  role                           user_role
  status                         user_status                     @default(ACTIVE)

  email_verified                 Boolean
  phone_verified                 Boolean

  current_address_id             Uuid?

  created_at                     DateTime                        @default(now())
  updated_at                     temporal.updatedAt()

  current_address                addresses?                      @relation("CurrentAddress", fields:[current_address_id], references:[id])

  addresses                      addresses[]                     @relation("UserAddresses")

  customer_profile               customer_profiles?
  provider_profile               provider_profiles?

  blocked_records                user_account_blocks[]           @relation("BlockedUser")
  blocked_by_admin               user_account_blocks[]           @relation("BlockerAdmin")

  reactivation_requests          account_reactivation_requests[] @relation("UserReactivationRequests")
  reviewed_reactivation_requests account_reactivation_requests[] @relation("ReviewedReactivationRequests")

  notifications                  notifications[]
}

enum weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum availability_override_type {
  DAY_OFF
  CUSTOM_HOURS
}

enum kyc_status {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum verification_document_type {
  IDENTITY
  CERTIFICATE
}

enum verification_document_status {
  PENDING
  APPROVED
  REJECTED
}

model provider_profiles {
  id                     Uuid                              @id @default(uuid())
  user_id                Uuid                              @unique
  business_name          VarChar(255)
  experience             VarChar(100)
  bio                    VarChar(2000)
  profile_image          VarChar(500)?
  skills                 VarChar(1000)?
  service_radius_km      Int?                              @default(20)
  accepting_leads        Boolean                           @default(true)
  travel_buffer_minutes  Int                               @default(30)
  completed_jobs         Int                               @default(0)
  kyc_status             kyc_status                        @default(NOT_SUBMITTED)
  created_at             DateTime                          @default(now())
  updated_at             temporal.updatedAt()

  user                   users                             @relation(fields:[user_id], references:[id])
  services               provider_services[]
  availabilities         provider_availability[]
  overrides              provider_availability_overrides[]
  verification_documents provider_verification_documents[]
}

model provider_verification_documents {
  id               Uuid                          @id @default(uuid())
  provider_id      Uuid

  document_type    verification_document_type
  document_name    VarChar(100)
  status           verification_document_status  @default(PENDING)
  rejection_reason VarChar(500)?

  created_at       DateTime                      @default(now())
  updated_at       temporal.updatedAt()

  provider         provider_profiles             @relation(fields:[provider_id], references:[id])

  files            provider_verification_files[]
}

model provider_verification_files {
  id          Uuid                            @id @default(uuid())
  document_id Uuid

  file_url    VarChar(1000)

  created_at  DateTime                        @default(now())

  document    provider_verification_documents @relation(fields:[document_id], references:[id])
}

model provider_availability {
  id          Uuid                 @id @default(uuid())
  provider_id Uuid
  day_of_week weekday

  start_time  VarChar(5)
  end_time    VarChar(5)

  created_at  DateTime             @default(now())
  updated_at  temporal.updatedAt()

  provider    provider_profiles    @relation(fields:[provider_id], references:[id])
}

model provider_availability_overrides {
  id            Uuid                       @id @default(uuid())
  provider_id   Uuid
  override_date DateTime

  type          availability_override_type

  start_time    VarChar(5)?
  end_time      VarChar(5)?

  reason        VarChar(255)?

  created_at    DateTime                   @default(now())
  updated_at    temporal.updatedAt()

  provider      provider_profiles          @relation(fields:[provider_id], references:[id])
}

model provider_services {
  id          Uuid              @id @default(uuid())
  provider_id Uuid
  service_id  Uuid
  created_at  DateTime          @default(now())

  provider    provider_profiles @relation(fields:[provider_id], references:[id])
  service     services          @relation(fields:[service_id], references:[id])

  @@unique([provider_id, service_id])
}

model addresses {
  id          Uuid                 @id @default(uuid())
  user_id     Uuid

  house_no    VarChar(100)?
  area        VarChar(255)
  city        VarChar(100)
  district    VarChar(100)
  state       VarChar(100)
  country     VarChar(100)
  pincode     VarChar(20)
  landmark    VarChar(255)?
  type        VarChar(50)

  latitude    Numeric(10, 7)?
  longitude   Numeric(10, 7)?

  created_at  DateTime             @default(now())
  updated_at  temporal.updatedAt()

  user        users                @relation("UserAddresses", fields:[user_id], references:[id])

  current_for users[]              @relation("CurrentAddress")
}

model customer_profiles {
  id                Uuid                 @id @default(uuid())
  user_id           Uuid                 @unique
  profile_image     VarChar(500)?
  service_radius_km Int?                 @default(20)
  created_at        DateTime             @default(now())
  updated_at        temporal.updatedAt()
  about             VarChar(500)

  user              users                @relation(fields:[user_id], references:[id])
}

model categories {
  id          Uuid                 @id @default(uuid())
  name        VarChar(100)         @unique
  description VarChar(500)?
  image       VarChar(500)?
  status      active_status        @default(ACTIVE)

  created_at  DateTime             @default(now())
  updated_at  temporal.updatedAt()

  services    services[]
}

model services {
  id          Uuid                 @id @default(uuid())
  category_id Uuid

  name        VarChar(150)
  description VarChar(1000)?
  image       VarChar(500)?
  status      active_status        @default(ACTIVE)

  created_at  DateTime             @default(now())
  updated_at  temporal.updatedAt()

  category    categories           @relation(fields:[category_id], references:[id])
}

model user_account_blocks {
  id                    Uuid                            @id @default(uuid())

  user_id               Uuid
  blocked_by            Uuid

  reason                VarChar(1000)

  blocked_at            DateTime                        @default(now())
  unblocked_at          DateTime?

  created_at            DateTime                        @default(now())
  updated_at            temporal.updatedAt()

  user                  users                           @relation("BlockedUser", fields:[user_id], references:[id])
  blocked_by_user       users                           @relation("BlockerAdmin", fields:[blocked_by], references:[id])

  reactivation_requests account_reactivation_requests[]
}

model account_reactivation_requests {
  id          Uuid                        @id @default(uuid())

  user_id     Uuid
  block_id    Uuid

  reason      VarChar(1000)

  status      reactivation_request_status @default(PENDING)

  reviewed_by Uuid?
  reviewed_at DateTime?

  created_at  DateTime                    @default(now())
  updated_at  temporal.updatedAt()

  user        users                       @relation("UserReactivationRequests", fields:[user_id], references:[id])
  block       user_account_blocks         @relation(fields:[block_id], references:[id])
  reviewer    users?                      @relation("ReviewedReactivationRequests", fields:[reviewed_by], references:[id])
}

model notifications {
  id           Uuid          @id @default(uuid())
  recipient_id Uuid
  type         VarChar(100)
  title        VarChar(150)
  message      VarChar(1000)
  data         Json?
  is_read      Boolean       @default(false)
  read_at      DateTime?
  created_at   DateTime      @default(now())

  recipient    users         @relation(fields:[recipient_id], references:[id], onDelete: Cascade)

  @@index([recipient_id, is_read, created_at])
}
