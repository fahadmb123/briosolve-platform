enum user_status {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum user_role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum active_status {
  ACTIVE
  INACTIVE
}

enum reactivation_request_status {
  PENDING
  APPROVED
  REJECTED
}

model users {
  id                             Uuid                            @id @default(uuid())
  name                           VarChar(100)
  email                          VarChar(255)                    @unique
  password_hash                  VarChar(255)
  phone                          VarChar(20)?

  role                           user_role
  status                         user_status                     @default(ACTIVE)

  email_verified                 Boolean
  phone_verified                 Boolean

  current_address_id             Uuid?

  created_at                     DateTime                        @default(now())
  updated_at                     temporal.updatedAt()

  current_address                addresses?                      @relation("CurrentAddress", fields:[current_address_id], references:[id])

  addresses                      addresses[]                     @relation("UserAddresses")

  customer_profile               customer_profiles?
  provider_profile               provider_profiles?

  blocked_records                user_account_blocks[]           @relation("BlockedUser")
  blocked_by_admin               user_account_blocks[]           @relation("BlockerAdmin")

  reactivation_requests          account_reactivation_requests[] @relation("UserReactivationRequests")
  reviewed_reactivation_requests account_reactivation_requests[] @relation("ReviewedReactivationRequests")

  notifications                  notifications[]
  push_subscriptions             push_subscriptions[]
  service_requests               service_requests[]              @relation("CustomerServiceRequests")
  bookings                       bookings[]                      @relation("CustomerBookings")
  conversation_participants      conversation_participants[]
  messages                       messages[]
  wallet                         wallets?
  support_tickets                support_tickets[]
}

enum weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum availability_override_type {
  DAY_OFF
  CUSTOM_HOURS
}

enum kyc_status {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum verification_document_type {
  IDENTITY
  CERTIFICATE
}

enum verification_document_status {
  PENDING
  APPROVED
  REJECTED
}

model provider_profiles {
  id                     Uuid                              @id @default(uuid())
  user_id                Uuid                              @unique
  business_name          VarChar(255)
  experience             VarChar(100)
  bio                    VarChar(2000)
  profile_image          VarChar(500)?
  skills                 VarChar(1000)?
  service_radius_km      Int?                              @default(20)
  accepting_leads        Boolean                           @default(true)
  travel_buffer_minutes  Int                               @default(30)
  completed_jobs         Int                               @default(0)
  kyc_status             kyc_status                        @default(NOT_SUBMITTED)
  created_at             DateTime                          @default(now())
  updated_at             temporal.updatedAt()

  user                   users                             @relation(fields:[user_id], references:[id])
  services               provider_services[]
  availabilities         provider_availability[]
  overrides              provider_availability_overrides[]
  verification_documents provider_verification_documents[]
  service_requests       service_request_providers[]
  quotations             quotations[]
  bookings               bookings[]
}

model provider_verification_documents {
  id               Uuid                          @id @default(uuid())
  provider_id      Uuid

  document_type    verification_document_type
  document_name    VarChar(100)
  status           verification_document_status  @default(PENDING)
  rejection_reason VarChar(500)?

  created_at       DateTime                      @default(now())
  updated_at       temporal.updatedAt()

  provider         provider_profiles             @relation(fields:[provider_id], references:[id])

  files            provider_verification_files[]
}

model provider_verification_files {
  id          Uuid                            @id @default(uuid())
  document_id Uuid

  file_url    VarChar(1000)

  created_at  DateTime                        @default(now())

  document    provider_verification_documents @relation(fields:[document_id], references:[id])
}

model provider_availability {
  id          Uuid                 @id @default(uuid())
  provider_id Uuid
  day_of_week weekday

  start_time  VarChar(5)
  end_time    VarChar(5)

  created_at  DateTime             @default(now())
  updated_at  temporal.updatedAt()

  provider    provider_profiles    @relation(fields:[provider_id], references:[id])
}

model provider_availability_overrides {
  id            Uuid                       @id @default(uuid())
  provider_id   Uuid
  override_date DateTime

  type          availability_override_type

  start_time    VarChar(5)?
  end_time      VarChar(5)?

  reason        VarChar(255)?

  created_at    DateTime                   @default(now())
  updated_at    temporal.updatedAt()

  provider      provider_profiles          @relation(fields:[provider_id], references:[id])
}

model provider_services {
  id          Uuid              @id @default(uuid())
  provider_id Uuid
  service_id  Uuid
  created_at  DateTime          @default(now())

  provider    provider_profiles @relation(fields:[provider_id], references:[id])
  service     services          @relation(fields:[service_id], references:[id])

  @@unique([provider_id, service_id])
}

model addresses {
  id               Uuid                 @id @default(uuid())
  user_id          Uuid

  house_no         VarChar(100)?
  area             VarChar(255)
  city             VarChar(100)
  district         VarChar(100)
  state            VarChar(100)
  country          VarChar(100)
  pincode          VarChar(20)
  landmark         VarChar(255)?
  type             VarChar(50)

  latitude         Numeric(10, 7)?
  longitude        Numeric(10, 7)?

  created_at       DateTime             @default(now())
  updated_at       temporal.updatedAt()

  user             users                @relation("UserAddresses", fields:[user_id], references:[id])

  current_for      users[]              @relation("CurrentAddress")
  service_requests service_requests[]
}

model customer_profiles {
  id            Uuid                 @id @default(uuid())
  user_id       Uuid                 @unique
  profile_image VarChar(500)?
  created_at    DateTime             @default(now())
  updated_at    temporal.updatedAt()
  about         VarChar(500)

  user          users                @relation(fields:[user_id], references:[id])
}

model categories {
  id               Uuid                 @id @default(uuid())
  name             VarChar(100)         @unique
  description      VarChar(500)?
  image            VarChar(500)?
  status           active_status        @default(ACTIVE)

  created_at       DateTime             @default(now())
  updated_at       temporal.updatedAt()

  services         services[]
  service_requests service_requests[]
}

model services {
  id               Uuid                 @id @default(uuid())
  category_id      Uuid

  name             VarChar(150)
  description      VarChar(1000)?
  image            VarChar(500)?
  status           active_status        @default(ACTIVE)
  questions        Json?

  created_at       DateTime             @default(now())
  updated_at       temporal.updatedAt()

  category         categories           @relation(fields:[category_id], references:[id])
  service_requests service_requests[]
}

model user_account_blocks {
  id                    Uuid                            @id @default(uuid())

  user_id               Uuid
  blocked_by            Uuid

  reason                VarChar(1000)

  blocked_at            DateTime                        @default(now())
  unblocked_at          DateTime?

  created_at            DateTime                        @default(now())
  updated_at            temporal.updatedAt()

  user                  users                           @relation("BlockedUser", fields:[user_id], references:[id])
  blocked_by_user       users                           @relation("BlockerAdmin", fields:[blocked_by], references:[id])

  reactivation_requests account_reactivation_requests[]
}

model account_reactivation_requests {
  id          Uuid                        @id @default(uuid())

  user_id     Uuid
  block_id    Uuid

  reason      VarChar(1000)

  status      reactivation_request_status @default(PENDING)

  reviewed_by Uuid?
  reviewed_at DateTime?

  created_at  DateTime                    @default(now())
  updated_at  temporal.updatedAt()

  user        users                       @relation("UserReactivationRequests", fields:[user_id], references:[id])
  block       user_account_blocks         @relation(fields:[block_id], references:[id])
  reviewer    users?                      @relation("ReviewedReactivationRequests", fields:[reviewed_by], references:[id])
}

model notifications {
  id           Uuid          @id @default(uuid())
  recipient_id Uuid
  type         VarChar(100)
  title        VarChar(150)
  title_code   VarChar(150)
  message      VarChar(1000)
  data         Json?
  is_read      Boolean       @default(false)
  read_at      DateTime?
  created_at   DateTime      @default(now())

  recipient    users         @relation(fields:[recipient_id], references:[id], onDelete: Cascade)

  @@index([recipient_id, is_read, created_at])
}

model push_subscriptions {
  id         Uuid          @id @default(uuid())
  user_id    Uuid
  endpoint   VarChar(1000) @unique
  p256dh     VarChar(255)
  auth       VarChar(255)
  created_at DateTime      @default(now())

  user       users         @relation(fields:[user_id], references:[id], onDelete: Cascade)

  @@index([user_id])
}

enum request_urgency {
  TODAY
  THIS_WEEK
  SPECIFIC_DATE
  FLEXIBLE
}

enum service_request_status {
  PENDING
  ACTIVE
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  CLOSED
}

model service_requests {
  id                  Uuid                        @id @default(uuid())
  customer_id         Uuid
  category_id         Uuid
  subservice_id       Uuid?

  title               VarChar(150)
  description         VarChar(1000)
  urgency             request_urgency
  specific_date       DateTime?
  address_id          Uuid
  available_time_from Time
  available_time_to   Time
  answers             Json?
  status              service_request_status      @default(PENDING)

  created_at          DateTime                    @default(now())
  updated_at          temporal.updatedAt()

  customer            users                       @relation("CustomerServiceRequests", fields:[customer_id], references:[id])
  category            categories                  @relation(fields:[category_id], references:[id])
  subservice          services?                   @relation(fields:[subservice_id], references:[id])
  address             addresses                   @relation(fields:[address_id], references:[id])

  images              service_request_images[]
  providers           service_request_providers[]
  quotations          quotations[]
  bookings            bookings[]
}

model service_request_images {
  id                 Uuid             @id @default(uuid())
  service_request_id Uuid

  image_key          VarChar(500)
  display_order      Int              @default(0)

  created_at         DateTime         @default(now())

  service_request    service_requests @relation(fields:[service_request_id], references:[id], onDelete: Cascade)

  @@index([service_request_id])
}

enum service_request_provider_status {
  MATCHED
  VIEWED
  QUOTED
  DECLINED
  EXPIRED
}

model service_request_providers {
  id                 Uuid                            @id @default(uuid())
  service_request_id Uuid
  provider_id        Uuid

  status             service_request_provider_status @default(MATCHED)

  matched_at         DateTime                        @default(now())
  viewed_at          DateTime?

  service_request    service_requests                @relation(fields:[service_request_id], references:[id], onDelete: Cascade)
  provider           provider_profiles               @relation(fields:[provider_id], references:[id], onDelete: Cascade)

  @@unique([service_request_id, provider_id])
  @@index([service_request_id])
  @@index([provider_id])
}

enum conversation_type {
  DIRECT
  GROUP
}

enum conversation_status {
  ACTIVE
  CLOSED
}

enum message_type {
  TEXT
  IMAGE
  FILE
}

model conversations {
  id           Uuid                        @id @default(uuid())
  type         conversation_type           @default(DIRECT)
  status       conversation_status         @default(ACTIVE)

  created_at   DateTime                    @default(now())
  updated_at   temporal.updatedAt()

  participants conversation_participants[]
  messages     messages[]
}

model conversation_participants {
  id              Uuid          @id @default(uuid())
  conversation_id Uuid
  user_id         Uuid
  last_read_at    DateTime?
  joined_at       DateTime      @default(now())

  conversation    conversations @relation(fields:[conversation_id], references:[id], onDelete: Cascade)
  user            users         @relation(fields:[user_id], references:[id], onDelete: Cascade)

  @@unique([conversation_id, user_id])
  @@index([conversation_id])
  @@index([user_id])
}

model messages {
  id              Uuid                 @id @default(uuid())
  conversation_id Uuid
  sender_id       Uuid
  content         String
  message_type    message_type         @default(TEXT)
  created_at      DateTime             @default(now())
  updated_at      temporal.updatedAt()
  deleted_at      DateTime?

  conversation    conversations        @relation(fields:[conversation_id], references:[id], onDelete: Cascade)
  sender          users                @relation(fields:[sender_id], references:[id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([sender_id])
  @@index([created_at])
}

enum quotation_type {
  FIXED
  ESTIMATED
  INSPECTION_REQUIRED
}

enum quotation_validity {
  HOURS_24
  HOURS_48
  DAYS_3
  DAYS_7
}

enum quotation_status {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

model quotations {
  id                  Uuid                 @id @default(uuid())
  service_request_id  Uuid
  provider_id         Uuid

  amount              Numeric(12, 2)
  quotation_type      quotation_type       @default(FIXED)
  work_description    VarChar(1000)
  included_items      Json
  excluded_items      Json
  estimated_duration  VarChar(60)?
  available_date_time VarChar(80)?
  valid_until         quotation_validity   @default(HOURS_24)
  valid_until_date    DateTime
  extra_charge_policy VarChar(300)
  rejection_reason    String?
  status              quotation_status     @default(PENDING)

  created_at          DateTime             @default(now())
  updated_at          temporal.updatedAt()

  service_request     service_requests     @relation(fields:[service_request_id], references:[id], onDelete: Cascade)
  provider            provider_profiles    @relation(fields:[provider_id], references:[id], onDelete: Cascade)
  booking             bookings?

  @@index([service_request_id])
  @@index([provider_id])
  @@index([status])
}

enum booking_status {
  CONFIRMED
  EN_ROUTE
  INSPECTION
  IN_PROGRESS
  PAYMENT_PENDING
  COMPLETED
  CANCELLED
  CLOSED
}

enum booking_payment_status {
  PENDING
  ADVANCE_PAID
  PAID
  REFUNDED
}

model bookings {
  id                 Uuid                   @id @default(uuid())
  booking_number     VarChar(50)            @unique
  service_request_id Uuid
  quotation_id       Uuid                   @unique
  customer_id        Uuid
  provider_id        Uuid

  total_amount       Numeric(12, 2)
  platform_fee       Numeric(12, 2)
  advance_amount     Numeric(12, 2)?        @default(0)
  status             booking_status         @default(CONFIRMED)
  payment_status     booking_payment_status @default(ADVANCE_PAID)

  scheduled_date     DateTime?
  scheduled_time     VarChar(80)?

  payment_id         VarChar(255)?
  order_id           VarChar(255)?

  notes              String?

  created_at         DateTime             @default(now())
  updated_at         temporal.updatedAt()

  service_request    service_requests     @relation(fields:[service_request_id], references:[id], onDelete: Cascade)
  quotation          quotations           @relation(fields:[quotation_id], references:[id], onDelete: Cascade)
  customer           users                @relation("CustomerBookings", fields:[customer_id], references:[id])
  provider           provider_profiles    @relation(fields:[provider_id], references:[id], onDelete: Cascade)
  wallet_transactions wallet_transactions[]

  @@index([service_request_id])
  @@index([quotation_id])
  @@index([customer_id])
  @@index([provider_id])
  @@index([status])
}

enum wallet_transaction_type {
  CREDIT
  DEBIT
}

enum wallet_transaction_category {
  REFUND
  EARNINGS
  PAYMENT
  WITHDRAWAL
  COMMISSION
}

model wallets {
  id           Uuid                  @id @default(uuid())
  user_id      Uuid                  @unique
  balance      Numeric(12, 2)
  currency     VarChar(10)           @default("INR")
  created_at   DateTime              @default(now())
  updated_at   temporal.updatedAt()

  user         users                 @relation(fields:[user_id], references:[id], onDelete: Cascade)
  transactions wallet_transactions[]

  @@index([user_id])
}

model wallet_transactions {
  id            Uuid                        @id @default(uuid())
  wallet_id     Uuid
  booking_id    Uuid?
  type          wallet_transaction_type
  category      wallet_transaction_category
  amount        Numeric(12, 2)
  balance_after Numeric(12, 2)
  description   VarChar(500)
  reference_id  VarChar(100)?
  created_at    DateTime                    @default(now())

  wallet        wallets                     @relation(fields:[wallet_id], references:[id], onDelete: Cascade)
  booking       bookings?                   @relation(fields:[booking_id], references:[id], onDelete: SetNull)

  @@index([wallet_id])
  @@index([booking_id])
  @@index([created_at])
}

enum ticket_status {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum ticket_priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ticket_creator_role {
  CUSTOMER
  PROVIDER
}

model support_tickets {
  id                   Uuid                 @id @default(uuid())
  ticket_number        VarChar(50)          @unique
  creator_id           Uuid
  creator_role         ticket_creator_role
  target_type          VarChar(50)          @default("GENERAL")
  target_id            VarChar(100)?
  target_number        VarChar(100)?
  category             VarChar(50)
  category_label       VarChar(100)
  subject              VarChar(255)
  description          VarChar(2000)
  metadata             Json?
  priority             ticket_priority      @default(HIGH)
  status               ticket_status        @default(OPEN)
  resolution_note      VarChar(2000)?
  settlement_decision  VarChar(50)?
  settlement_details   VarChar(500)?
  assigned_to          Uuid?
  created_at           DateTime             @default(now())
  updated_at           temporal.updatedAt()

  creator              users                @relation(fields:[creator_id], references:[id], onDelete: Cascade)
  messages             support_ticket_messages[]

  @@index([creator_id])
  @@index([target_type])
  @@index([target_id])
  @@index([status])
  @@index([created_at])
}

model support_ticket_messages {
  id          Uuid                @id @default(uuid())
  ticket_id   Uuid
  author_id   Uuid?
  author_name VarChar(150)
  author_role VarChar(50)
  message     VarChar(2000)
  created_at  DateTime            @default(now())

  ticket      support_tickets     @relation(fields:[ticket_id], references:[id], onDelete: Cascade)

  @@index([ticket_id])
  @@index([created_at])
}
