    "execute": [
      {
        "description": "create table \"quotations\"",
        "sql": "CREATE TABLE \"public\".\"quotations\" (\n  \"amount\" numeric(12,2) NOT NULL,\n  \"available_date_time\" character varying(80),\n  \"created_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"estimated_duration\" character varying(60),\n  \"excluded_items\" json NOT NULL,\n  \"extra_charge_policy\" character varying(300) NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"included_items\" json NOT NULL,\n  \"message_to_customer\" character varying(500),\n  \"provider_id\" uuid NOT NULL,\n  \"quotation_type\" text DEFAULT 'FIXED' NOT NULL,\n  \"service_request_id\" uuid NOT NULL,\n  \"status\" text DEFAULT 'PENDING' NOT NULL,\n  \"updated_at\" timestamptz NOT NULL,\n  \"valid_until\" text DEFAULT 'HOURS_24' NOT NULL,\n  \"valid_until_date\" timestamptz NOT NULL,\n  \"work_description\" character varying(1000) NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"quotations_quotation_type_check_4adf5ec5\" CHECK (\"quotation_type\" IN ('FIXED', 'ESTIMATED', 'INSPECTION_REQUIRED')),\n  CONSTRAINT \"quotations_status_check_9282885c\" CHECK (\"status\" IN ('PENDING', 'ACCEPTED', 'REJECTED', 'EXPIRED', 'WITHDRAWN')),\n  CONSTRAINT \"quotations_valid_until_check_23f86f6a\" CHECK (\"valid_until\" IN ('HOURS_24', 'HOURS_48', 'DAYS_3', 'DAYS_7'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"quotations\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"quotations\""
        ]
      }
    ]
  },
