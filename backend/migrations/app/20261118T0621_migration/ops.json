    ],
    "execute": [
      {
        "description": "create table \"bookings\"",
        "sql": "CREATE TABLE \"public\".\"bookings\" (\n  \"booking_number\" character varying(50) NOT NULL,\n  \"created_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"customer_id\" uuid NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"notes\" character varying(1000),\n  \"order_id\" character varying(255),\n  \"payment_id\" character varying(255),\n  \"platform_fee\" numeric(12,2) NOT NULL,\n  \"provider_id\" uuid NOT NULL,\n  \"quotation_id\" uuid NOT NULL,\n  \"scheduled_date\" timestamptz,\n  \"scheduled_time\" character varying(80),\n  \"service_request_id\" uuid NOT NULL,\n  \"status\" text DEFAULT 'CONFIRMED' NOT NULL,\n  \"total_amount\" numeric(12,2) NOT NULL,\n  \"updated_at\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"bookings_status_check_9a77072c\" CHECK (\"status\" IN ('CONFIRMED', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"bookings\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"bookings\""
        ]
      }
    ]
  },
